rules_version = '2';

// NOTE: No firestore.rules file existed in this repo before this change —
// still not deployed/tested against the Firebase emulator as of this
// update. Review with the team before deploying. Updated to cover:
// vendor menu writes, the 6-stage order status flow, student cancellation,
// and the new menuChangeRequests collection (price-change governance).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwnUser() {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True if the signed-in user's email matches the vendor doc being
    // acted on. Vendors have no uid field in this schema (see
    // unified-login.ts) — email is the only reliable link.
    function isOwnVendor(vendorEmail) {
      return isSignedIn() && request.auth.token.email == vendorEmail;
    }

    // users/{uid}
    match /users/{userId} {
      allow read: if isOwnUser() || isAdmin();
      allow create: if isOwnUser();
      allow update: if isOwnUser() || isAdmin();
      allow delete: if false;
    }

    // admins/{uid} — hardcoded, never written from the client
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // vendors/{vendorId}
    match /vendors/{vendorId} {
      allow read: if isSignedIn();

      // Only admin creates vendors.
      allow create: if isAdmin();

      // Vendor can update ONLY their own doc, and only the `status` field
      // (the open/closed toggle). Anything else — name, upiID, rating,
      // queueNumber, etc. — stays admin-only, or is written by a trusted
      // transaction (see createOrder, which increments queueNumber).
      allow update: if isAdmin() ||
        (isOwnVendor(resource.data.email) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status']));

      allow delete: if isAdmin();
    }

    // menuItems/{itemId}
    // Students read everything. A vendor may create/update/delete only
    // items whose vendorId matches their own vendor doc's id. Price is
    // intentionally NOT excluded from vendor writes here — the 3-day
    // governance window is enforced in application code
    // (menu-governance-service.ts), not in these rules, because rules
    // cannot easily resolve "this vendor's createdAt + 3 days" against
    // a separate vendor document for a write on a menuItems document.
    // This means a compromised/modified client could currently bypass
    // governance and write price directly — flagged as a known gap,
    // not yet closed.
    match /menuItems/{itemId} {
      allow read: if true;

      allow create: if isAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)) &&
         isOwnVendor(
           get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.email
         ));

      allow update, delete: if isAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/vendors/$(resource.data.vendorId)) &&
         isOwnVendor(
           get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.email
         ));
    }

    // orders/{orderId}
    match /orders/{orderId} {
      allow read: if isSignedIn(); // tighten to owner/vendor/admin once auth claims for vendor are in place
      allow create: if isSignedIn();

      // Vendor rejecting a pending order: allowed to set status + rejectionReason only.
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'rejected' &&
         request.resource.data.rejectionReason is string &&
         request.resource.data.rejectionReason.size() > 0) ||

        // Student cancelling their own order, only while still pending.
        (isSignedIn() &&
         resource.data.userId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt'])) ||

        // Vendor advancing status through the normal flow — timestamp
        // fields are additive only, never removed.
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly([
             'status', 'updatedAt', 'acceptedAt', 'preparingAt',
             'readyAt', 'completedAt', 'deliveredAt'
           ]));

      allow delete: if false;
    }

    // menuChangeRequests/{requestId}
    // Vendor creates requests for their own vendorId, can read their own.
    // Only admin reviews (approve/reject) — that path also writes the
    // live price onto menuItems, handled by menu-governance-service.ts.
    match /menuChangeRequests/{requestId} {
      allow read: if isAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/vendors/$(resource.data.vendorId)) &&
         isOwnVendor(
           get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.email
         ));

      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.status == 'PENDING' &&
         exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)) &&
         isOwnVendor(
           get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.email
         ));

      allow update: if isAdmin(); // approve/reject is admin-only
      allow delete: if false;
    }
  }
}